# Copy this file to local.properties and fill in your own values.
# local.properties is ignored by git and must never contain committed secrets.
sdk.dir=/path/to/android-sdk

# Optional OpenAI-compatible chat endpoint. Leave CHAT_API_KEY empty to use
# the built-in offline demo replies.
CHAT_API_BASE_URL=https://api.openai.com/v1
CHAT_API_MODEL=gpt-4o-mini
CHAT_API_KEY=
